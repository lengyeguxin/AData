anomaly_detection:
  enable_price_check: true
  enable_suspension_check: true
  max_change_pct: 20
dashboard:
  database:
    fallback: database/adata.db
    path: database/adata_snapshot.db
    use_snapshot: true
database:
  path: database/adata.db
  type: duckdb
fetch:
  check_interval: 60
  enabled: true
  start_date: '20210101'
logging:
  backup_count: 5
  file: logs/adata.log
  level: INFO
  max_size: 10MB
scheduler:
  daily_update_time: '18:00'
  monthly_update_time: '19:00'
  weekly_update_time: '19:00'
snapshot:
  enabled: true
  interval: 90
  locations:
  - database/adata_snapshot.db
  - /home/my/claude-project/AiStock/database/adata_snapshot.db
